# API keys — never commit
**/.env
*.key
**/config.local.py
**/data/config.json

# Python bytecode + virtualenvs (any depth)
**/__pycache__/
**/*.pyc
**/venv/
**/.venv/

# Node
**/node_modules/
**/build/
**/package-lock.json

# Runtime data (cases, history, generated indexes)
**/backend/data/
!**/backend/data/.gitkeep

# Vendor third-party repos (cloned via scripts/setup_vendor.sh — not committed)
vendor/
**/vendor/

# MITRE ATT&CK STIX dataset (47MB, downloaded by setup script)
**/backend/intel/mitre/

# Bundled intel datasets (regenerated; too large for git)
**/backend/intel/feeds/
**/backend/intel/sigma/
**/backend/intel/warninglists/

# Scratch + local notes
scratch/
*.local.md

# OS
.DS_Store
.vscode/
*.swp
Thumbs.db
