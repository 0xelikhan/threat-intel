# Fixes react-scripts 5.0.1 + webpack-dev-server 4.x incompatibility
# where `allowedHosts` defaults to an array containing an empty string,
# tripping the dev server's own schema check at boot with
# `options.allowedHosts[0] should be a non-empty string`.
#
# Using 127.0.0.1 (not `localhost`) so the dev server binds IPv4
# explicitly — `HOST=localhost` picks whichever entry DNS resolves
# first, which on many systems is `::1` and then IPv4 tooling
# (curl 127.0.0.1, some fetch libraries) can't connect. Browsers
# hitting http://localhost:3000 still work either way.
HOST=127.0.0.1
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Proxy /api/* to the backend running on :8000 during dev. Production
# builds don't use this — nginx / Azure Container App routes /api itself.
# CRA reads this at start-time; runtime env vars need to prefix REACT_APP_.
BROWSER=none
