# RECON backend environment template.
# Copy to .env, fill in your values. .env is gitignored — never commit it.
# Local dev launches with: uvicorn main:app --port 8000 --env-file .env

# ─── LLM provider ──────────────────────────────────────────────────────
# LLM_PROVIDER picks which provider every AI call routes through. Options:
#   openai       — OpenAI public + Azure OpenAI (default)
#   anthropic    — Claude Sonnet
#   ollama       — local Ollama install (no key required)
LLM_PROVIDER=openai

# OpenAI / Azure OpenAI
# For Azure: OPENAI_BASE_URL points at https://<resource>.openai.azure.com/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
FAST_AI_MODEL=gpt-4o-mini

# Anthropic (only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (only when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ─── Auth gate ─────────────────────────────────────────────────────────
# AuthGateMiddleware fails closed (503 on every /api/auth/login attempt)
# when these are unset. Generate the hash with:
#   ./venv/Scripts/python.exe -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt(rounds=12)).decode())"
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
# AUTH_SESSION_SECRET signs the session cookie (12h max age). Rotate to
# invalidate every active session. Required in production; a dev
# fallback is used when unset (only safe on localhost).
AUTH_SESSION_SECRET=

# ─── Threat-intelligence sources ───────────────────────────────────────
# Every key is optional — sources without keys are skipped, the rest
# of the pipeline still runs. The Settings UI also accepts these.
VIRUSTOTAL_KEY=
ABUSEIPDB_KEY=
OTX_KEY=
URLSCAN_KEY=
GREYNOISE_KEY=
PULSEDIVE_KEY=
MALTIVERSE_KEY=
IPINFO_TOKEN=
WHOISXML_KEY=
GOOGLE_API_KEY=
HYBRID_ANALYSIS_KEY=

# abuse.ch — single Auth-Key shared across MalwareBazaar, ThreatFox,
# and URLhaus. Free at https://auth.abuse.ch (a 30-second signup).
# Without it, requests still go through but get rate-limited / soft-
# blocked since late 2024.
ABUSECH_AUTH_KEY=
MALWAREBAZAAR_API_KEY=

# Censys: prefer the v3 Personal Access Token (CENSYS_API_KEY). The
# legacy v2 ID/Secret pair below is still accepted as a fallback for
# older deployments that haven't rotated yet — but new deployments
# should leave CENSYS_ID / CENSYS_SECRET blank.
CENSYS_API_KEY=
CENSYS_ID=
CENSYS_SECRET=
CROWDSEC_KEY=
CRIMINAL_IP_KEY=
PROXYCHECK_KEY=
FULLHUNT_KEY=
PHISHTANK_KEY=

# OpenCTI bidirectional sync (push analyses + pull existing context)
OPENCTI_URL=
OPENCTI_TOKEN=

# ─── Platform hardening ────────────────────────────────────────────────
# Set RECON_HTTPS=1 in production behind TLS so:
#   * session cookies get the Secure attribute
#   * HSTS header is sent
# Leave unset for local plain-HTTP dev so smoke-test scripts can
# establish sessions.
# RECON_HTTPS=1

# Set RECON_ENV=production to suppress error tracebacks from API
# responses. Required for shipping.
# RECON_ENV=production

# Set RECON_CORS to a comma-separated allowlist of origins. Default
# (when unset) is http://localhost:3000,http://127.0.0.1:3000 for dev.
# RECON_CORS=https://your-app.example

# Optional Fernet symmetric encryption for at-rest API keys in
# config.json. Without it keys are stored plaintext (still .gitignored).
# RECON_SECRET=

# ─── Email composer (optional) ─────────────────────────────────────────
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM_NAME=
# EMAIL_FROM_ADDRESS=
# EMAIL_SIGNATURE=
# EMAIL_TEAM_NAME=

# ─── Concurrency / perf tuning (sensible defaults exist) ──────────────
# ENRICH_CONCURRENCY=10
# ENRICH_SOURCE_TIMEOUT_S=12
# ENRICH_POOL_LIMIT=100
# ENRICH_POOL_PER_HOST=10
# CIRCUIT_BREAKER_THRESHOLD=3
# CIRCUIT_BREAKER_COOLDOWN_S=300
# LOG_LEVEL=INFO
